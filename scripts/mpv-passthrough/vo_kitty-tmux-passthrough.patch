+/*
+ * Append a kitty image DCS: a control part, an optional base64
+ * payload, and the ST terminator. The control part and the ST go
+ * through the envelope with ESC doubling. The payload carries no
+ * ESC bytes and is appended verbatim inside the envelope. Keeping
+ * the payload inside the envelope is what the original code did
+ * not do: tmux dropped the raw payload and the terminal received
+ * no image data.
+ */
+static inline void append_kitty_dcs(struct priv *p, bstr *bs, bstr ctrl,
+                                    bstr data)
+{
+    if (!p->dcs_prefix.len) {
+        bstr_xappend(p, bs, ctrl);
+        if (data.len)
+            bstr_xappend(p, bs, data);
+        bstr_xappend(p, bs, KITTY_ESC_END);
+        return;
+    }
+    bstr_xappend(p, bs, p->dcs_prefix);
+    append_doubled(p, bs, ctrl);
+    if (data.len)
+        bstr_xappend(p, bs, data);
+    bstr_xappend(p, bs, (bstr){"\033\033\\", 3});
     bstr_xappend(p, bs, p->dcs_suffix);
 }
 
+/* Immediate-write variant for reconfig and uninit. */
+static void write_kitty_dcs(struct priv *p, bstr ctrl, bstr data)
+{
+    bstr buf = {NULL, 0};
+    append_kitty_dcs(p, &buf, ctrl, data);
+    write_bstr(buf);
+    if (buf.start)
+        talloc_free(buf.start);
+}
