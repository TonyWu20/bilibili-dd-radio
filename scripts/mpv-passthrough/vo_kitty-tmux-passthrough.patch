From b4069753a36f3ed80e2897f95aff493b265e7874 Mon Sep 17 00:00:00 2001
From: TonyWu20 <tony.w21@gmail.com>
Date: Sun, 25 Oct 2026 08:36:21 +0800
Subject: [PATCH 3/3] vo_kitty: drop the NUL from the doubled ST literal

The doubled ST is ESC ESC backslash, three bytes. The literal
included its NUL terminator, which landed inside the envelope.
---
 video/out/vo_kitty.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/video/out/vo_kitty.c b/video/out/vo_kitty.c
index c88f264..89a4ce6 100644
--- a/video/out/vo_kitty.c
+++ b/video/out/vo_kitty.c
@@ -161,7 +161,7 @@ static inline void append_kitty_dcs(struct priv *p, bstr *bs, bstr ctrl,
     append_doubled(bs, ctrl);
     if (data.len)
         bstr_xappend(NULL, bs, data);
-    bstr_xappend(NULL, bs, (bstr){"\033\033\\", 4});
+    bstr_xappend(NULL, bs, (bstr){"\033\033\\", 3});
     bstr_xappend(NULL, bs, p->dcs_suffix);
 }
 
-- 
2.55.0

